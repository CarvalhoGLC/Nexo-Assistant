generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Valores controlados (status, prioridade, papéis...) ficam como String no banco e são tipados em lib/types.ts.
// Postgres em todos os ambientes (local, teste e produção) para não haver diferença de comportamento.

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String // hash scrypt (formato "salt:hash"), nunca texto puro
  passwordChangedAt DateTime   @default(now())
  role          String         @default("EMPLOYEE")
  department    String         @default("Financeiro")
  conversations Conversation[]
  tickets       Ticket[]
  sessions      Session[]
  createdAt     DateTime       @default(now())
}

/// Sessão de login. Guarda o contador do limite de mensagens (por sessão, não por conversa).
model Session {
  id           String   @id @default(cuid())
  userId       String
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id                String    @id @default(cuid())
  userId            String
  /// AGENT | AWAITING (aguardando atendente) | ANALYST (analista atendendo) | CLOSED
  status            String    @default("AGENT")
  assignedAnalystId String?
  // Resumo da transferência (preenchido quando o agent chama um analista)
  handoffReason     String? // user_request | critical | overdue | low_confidence
  handoffSummary    String?
  handoffLevel      String? // N1 | N2
  handoffConfidence Float?
  handoffTicket     String? // número do chamado relacionado
  handoffAt         DateTime?
  user              User      @relation(fields: [userId], references: [id])
  messages          Message[]
  drafts            Draft[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  /// USER | AGENT | ANALYST | SYSTEM
  sender         String
  text           String
  steps          String? // JSON: DecisionStep[] (o que entendeu, ação, confiança, motivo)
  cards          String? // JSON: TicketCard[]
  options        String? // JSON: QuickOptions
  draftId        String?
  authorName     String? // nome do analista (mensagens ANALYST)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

/// Rascunho proposto pelo agent. Só vira chamado quando o funcionário confirma (endpoint no servidor).
model Draft {
  id             String       @id @default(cuid())
  code           String       @unique // ex.: D-381
  conversationId String
  kind           String // create | update | reopen
  ticketNumber   String? // update/reopen
  title          String
  description    String
  type           String
  category       String
  priority       String
  priorityReason String
  affected       String
  dueAt          DateTime
  /// PENDING | CONFIRMED | CANCELLED | SUPERSEDED
  status         String       @default("PENDING")
  resultNumber   String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Ticket {
  id          String    @id @default(cuid())
  number      String    @unique
  userId      String
  title       String
  description String
  type        String
  category    String
  priority    String
  status      String
  affected    String
  dueAt       DateTime?
  lastUpdate  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id])
}

model HelpArticle {
  id       String @id @default(cuid())
  title    String
  content  String
  category String
}
